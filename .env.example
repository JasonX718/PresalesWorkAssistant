# =============================================================================
# AI Work Assistant - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# --- OpenAI Configuration ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
# Model for chat completions
LLM_MODEL=gpt-4o
# Model for embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# --- ChromaDB Configuration ---
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=ai_work_assistant

# --- Application Configuration ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
LOG_LEVEL=INFO

# --- Knowledge Base Configuration ---
# Maximum chunk size for document splitting (characters)
CHUNK_SIZE=800
CHUNK_OVERLAP=200
# Maximum number of search results to return
MAX_SEARCH_RESULTS=5

# --- Bootstrap Configuration ---
SEED_DATA_DIR=./data/seed
BOOTSTRAP_RECORD_COUNT=1000

# --- URL Ingestion Configuration ---
# Timeout for fetching URLs (seconds)
URL_FETCH_TIMEOUT=30
# User agent for web requests
URL_USER_AGENT=AIWorkAssistant/1.0

# --- Time Limits (seconds) ---
TROUBLESHOOTING_TIME_LIMIT=600
TECH_QA_TIME_LIMIT=180
WEEKLY_REPORT_TIME_LIMIT=300
BRIEFING_TIME_LIMIT=900
ESCALATION_TIME_LIMIT=600
